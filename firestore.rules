rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isEmployee() {
      return signedIn()
        && exists(/databases/$(database)/documents/employees/$(request.auth.uid))
        && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.locationId is string
        && (
          get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == "employee"
          || get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == "owner"
        );
    }
    function canReadRecord(data) {
      return isEmployee()
        && data.locationId == get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.locationId
        && (
          get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == "owner"
          || data.employeeId == request.auth.uid
        );
    }

    match /employees/{uid} {
      allow read: if isEmployee() && request.auth.uid == uid;
      allow write: if false;
    }

    // Customer identities and all portal data are available only through server APIs.
    match /customerAccounts/{uid} { allow read, write: if false; }

    // All writes stay server-only. Reads require matching location and role scope.
    match /clients/{id} { allow read: if canReadRecord(resource.data); allow write: if false; }
    match /vehicles/{id} { allow read: if canReadRecord(resource.data); allow write: if false; }
    match /policies/{id} { allow read: if canReadRecord(resource.data); allow write: if false; }
    match /installments/{id} { allow read: if canReadRecord(resource.data); allow write: if false; }
    match /auditLogs/{id} { allow read: if canReadRecord(resource.data); allow write: if false; }

    // OAuth refresh tokens and state are server-only.
    match /googleConnections/{id} { allow read, write: if false; }
    match /oauthStates/{id} { allow read, write: if false; }

    match /{document=**} { allow read, write: if false; }
  }
}
