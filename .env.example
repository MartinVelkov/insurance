# Public Firebase web config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (service account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes if pasted from JSON.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google OAuth / Calendar API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Canonical server-side application URL. No trailing slash.
APP_BASE_URL=http://localhost:3000
# Must exactly equal APP_BASE_URL + /api/google/callback and the URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# 32 random bytes, base64 encoded. Example generation:
# openssl rand -base64 32
CALENDAR_TOKEN_ENCRYPTION_KEY=
